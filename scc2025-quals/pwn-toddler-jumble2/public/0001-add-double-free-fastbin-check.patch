From 7f9bca40374f7e20bc3e88d45fe5d15698f22676 Mon Sep 17 00:00:00 2001
From: k4 <k4@nya.com>
Date: Fri, 14 Mar 2025 21:37:23 +0700
Subject: [PATCH] add double free fastbin check

---
 malloc/malloc.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/malloc/malloc.c b/malloc/malloc.c
index 27dfd1eb90..2f09de6356 100644
--- a/malloc/malloc.c
+++ b/malloc/malloc.c
@@ -4566,6 +4566,15 @@ _int_free_check (mstate av, mchunkptr p, INTERNAL_SIZE_T size)
   check_inuse_chunk (av, p);
 }
 
+void fastbin_double_free_check(mchunkptr p, mchunkptr fb) {
+  while(fb != NULL) {
+    if (p == fb) {
+      malloc_printerr("okay it's not THAT easy.");
+    }
+    fb = REVEAL_PTR(fb->fd);
+  } 
+}
+
 /* Free chunk P of SIZE bytes to the arena.  HAVE_LOCK indicates where
    the arena for P has already been locked.  Caller must ensure chunk
    and size are valid.  */
@@ -4622,6 +4631,7 @@ _int_free_chunk (mstate av, mchunkptr p, INTERNAL_SIZE_T size, int have_lock)
 
     if (SINGLE_THREAD_P)
       {
+        fastbin_double_free_check(p, *fb);
 	/* Check that the top of the bin is not the record we are going to
 	   add (i.e., double free).  */
 	if (__builtin_expect (old == p, 0))
-- 
2.48.1

