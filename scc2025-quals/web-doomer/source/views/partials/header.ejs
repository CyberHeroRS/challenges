<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            background-color: #000;
            color: #fff;
        }

        .header {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem;
            background-color: #111;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            margin-left: 1rem;
            flex: 1;
            text-align: center;
        }

        .logo a {
            color: #fff;
            text-decoration: none;
        }

        .logo h1 {
            font-size: 1.8rem;
            letter-spacing: 1px;
        }

        .auth-buttons {
            display: flex;
            gap: 1rem;
            margin-right: 1rem;
            min-width: 180px;
            align-items: center;
        }

        .btn {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .btn-login {
            background-color: transparent;
            color: #1DA1F2;
            border: 1px solid #1DA1F2;
        }

        .btn-login:hover {
            background-color: rgba(29, 161, 242, 0.1);
        }

        .btn-signup {
            background-color: #1DA1F2;
            color: white;
        }

        .btn-signup:hover {
            background-color: #1a91da;
        }

        .username {
            color: #1DA1F2;
            font-weight: bold;
            text-decoration: none;
        }

        .username:hover {
            text-decoration: underline;
        }

        .content {
            margin-top: 80px;
            padding: 1rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
    </style>
</head>
<body>
    <div class="header">
        <div style="width: 180px"></div>
        <div class="logo">
            <a href="/"><h1><%= title %></h1></a>
        </div>
        <div class="auth-buttons">
            <% if (locals.user) { %>
                <a href="/users/@<%= user.username %>" class="username">@<%= user.username %></a>
                <a href="/logout" class="btn btn-login">Logout</a>
            <% } else { %>
                <a href="/login" class="btn btn-login">Log in</a>
                <a href="/register" class="btn btn-signup">Sign up</a>
            <% } %>
        </div>
    </div>
    <div class="content"> 