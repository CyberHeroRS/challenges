FROM node:18-alpine AS frontend-builder
WORKDIR /app/views

# Copy package files first to leverage Docker cache
COPY views/package*.json ./
# Use npm ci instead of npm install for faster, more reliable builds
RUN npm ci --no-audit --no-progress

# Copy only necessary frontend files
COPY views/src ./src
COPY views/public ./public

# Build the frontend
RUN npm run build

FROM node:18-alpine AS backend-builder
WORKDIR /app

# Copy package files first to leverage Docker cache
COPY package*.json ./
# Use npm ci for faster, more reliable builds
RUN npm ci --no-audit --no-progress --only=production

FROM node:18-alpine
WORKDIR /app

# Copy only what's needed from the builders
COPY --from=backend-builder /app/node_modules ./node_modules
COPY --from=backend-builder /app/package*.json ./
COPY src/ ./src/
COPY --from=frontend-builder /app/views/build ./views/build
COPY init.sql ./

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production

EXPOSE 3000
CMD ["sh", "/entrypoint.sh"]
