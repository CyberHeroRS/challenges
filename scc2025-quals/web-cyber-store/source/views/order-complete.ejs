<div class="text-center">
  <h1>Thank You for Your Order!</h1>
  <p>Your order has been processed successfully.</p>
  <div class="mt-4 mb-4" style="height: 800px">
    <object
      data="/receipt/<%= orderId %>"
      type="application/pdf"
      width="100%"
      height="100%"
      style="border: 1px solid #dee2e6; border-radius: 0.25rem"
    >
      <p>
        It appears you don't have a PDF plugin for this browser. You can
        <a href="/receipt/<%= orderId %>"
          >click here to download the PDF file.</a
        >
      </p>
    </object>
  </div>
  <div class="mt-3">
    <a href="/products" class="btn btn-primary">Continue Shopping</a>
  </div>
</div>
