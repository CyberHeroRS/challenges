FROM debian:trixie-slim AS builder
RUN apt-get update && apt-get install -y build-essential
WORKDIR /build
COPY ./src ./src
COPY ./Makefile .
RUN make

FROM scratch AS export
COPY --from=builder /build/bigvm2 /
COPY --from=builder /lib/x86_64-linux-gnu/libc.so.6 /glibc/
COPY --from=builder /lib/x86_64-linux-gnu/libm.so.6 /glibc/
COPY --from=builder /lib/x86_64-linux-gnu/libstdc++.so.6 /glibc/
COPY --from=builder /lib/x86_64-linux-gnu/libgcc_s.so.1 /glibc/
COPY --from=builder /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /glibc/