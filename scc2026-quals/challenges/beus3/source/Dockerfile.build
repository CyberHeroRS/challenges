FROM debian:bullseye-slim@sha256:95a3884fee36b8f33bf32a6bbffa8dffe6cab6089b841cec45fb47c581a2709d AS builder
RUN apt-get update && apt-get install -y build-essential
WORKDIR /build
COPY ./source.c .
RUN gcc -fstack-protector-strong -Wl,-z,relro,-z,now -fPIE -pie source.c -o beus3

FROM scratch AS export
COPY --from=builder /build/beus3 /
COPY --from=builder /lib/x86_64-linux-gnu/libc.so.6 /
COPY --from=builder /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /