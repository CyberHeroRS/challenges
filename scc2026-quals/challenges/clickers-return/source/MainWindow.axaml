<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClickersReturn.MainWindow"
        Title="Clicker's Return"
        Width="500" Height="400"
        Background="#1a1a2e">
    
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="🎯 CLICKER'S RETURN 🎯" 
                   FontSize="28" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,10"
                   Foreground="#e94560"/>
        
        <!-- Main Content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="InstructionText"
                       Text="Click the button EXACTLY at 13.37 seconds!"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="#eee"
                       Margin="0,0,0,20"/>
            
            <TextBlock x:Name="TimerText"
                       Text="0.00"
                       FontSize="72"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#16c79a"
                       Margin="0,0,0,30"/>
            
            <Button x:Name="ActionButton"
                    Content="START"
                    FontSize="24"
                    FontWeight="Bold"
                    Padding="40,15"
                    HorizontalAlignment="Center"
                    Background="#e94560"
                    Foreground="White"
                    Click="OnButtonClick"/>
        </StackPanel>
        
        <!-- Progress -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="Round: " FontSize="18" Foreground="#eee"/>
            <TextBlock x:Name="RoundText" Text="0/3" FontSize="18" FontWeight="Bold" Foreground="#f9ed69"/>
        </StackPanel>
        
        <!-- Status -->
        <TextBlock Grid.Row="3" 
                   x:Name="StatusText"
                   Text="Press START to begin"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="#888"
                   Margin="0,5,0,20"/>
    </Grid>
</Window>
