name: "GitBin"
author: "DragonSec SI"
category: "web"

description: "GitBin is a service that lets you host Git repositories quickly - like PasteBin, but for Git."
connection_info: http://<team-password>-gitbin.playground.cyberhero.rs

value: 500
type: "dynamic"
extra:
  initial: 500
  decay: 20
  minimum: 50
  function: logarithmic

files:
  - public/chall.zip
flags:
  - "SCC{g1t_syml1nk_r3kt}"
tags: []

state: "visible"
version: "0.1"
